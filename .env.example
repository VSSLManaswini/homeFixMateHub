# Replace these with REAL values from Supabase → Project Settings → API
# Do not leave xxxx or ... placeholders — signup will not appear until keys are valid.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Razorpay publishable key (optional for Payment Links; required only for Checkout fallback)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# Soft-dev ONLY: skip Razorpay and mark paid via pay_* RPCs. Never set on Vercel/production.
# VITE_MOCK_PAYMENTS=true
